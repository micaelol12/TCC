{
  "name": "8values-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "shared",
    "extension"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=8values-textos",
    "build": "npm run build --workspace=8values-textos && npm run build --workspace=8values-extension",
    "test": "vitest run",
    "test:browser": "node scripts/test-browser.mjs",
    "test:reports": "node scripts/test-reports-browser.mjs",
    "check:questions": "node web/scripts/check-questions.mjs",
    "package:extension": "npm run package --workspace=8values-extension"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
