{
  "name": "8values-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node ../web/scripts/check-questions.mjs && node scripts/icons.mjs",
    "build": "tsc -b && vite build --mode development",
    "build:production": "npm run prebuild && tsc -b && vite build --mode production",
    "build:lab": "npm run prebuild && tsc -b && vite build --mode lab",
    "package:lab": "npm run build:lab && node scripts/package.mjs --lab",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs",
    "package:production": "npm run build:production && node scripts/package.mjs"
  },
  "dependencies": {
    "@8values/shared": "0.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
