# Start with APP_ENV=lab (npm run api:lab does this).
# Process > API .env.lab > API .env > root .env.
APP_ENV=lab
EXPERIMENTAL_CONFIG_ENABLED=true
# Lab ignores all server API keys, including process and shared .env values.
# Register your own TypeSafe/Maritaca/Gemini keys in the site or extension API keys tab.
JEV_MODEL=jev-1.13.0
JEV_POLARITY_PRIMITIVE=score
JEV_DECISION_RULE=nivel
LLM_MODEL=sabia-4
ALLOWED_JEV_MODELS=jev-1.13.0
ALLOWED_LLM_MODELS=sabia-4,sabiazinho-4
ALLOWED_GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash
CHUNK_TOKENS=600
JEV_RELEVANCE_MARGIN_MIN=0.60
JEV_LEVEL_CONFIDENCE_MIN=0.50
JEV_DIRECTION_MARGIN_MIN=0.20
MIN_VALID_CHUNKS=16
BOOTSTRAP_SAMPLES=2000
BOOTSTRAP_SEED=42
# Dedicated database by default: data/reports-lab.sqlite3.
# LAB_REPORTS_DB_PATH=C:/dados/8values-lab/reports.sqlite3
