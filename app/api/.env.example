# Opcional: as chaves também podem ficar no .env da raiz do projeto TCC.
# Prioridade: variáveis do processo > app/api/.env > .env da raiz.
TYPESAFE_API_KEY=
MARITACA_API_KEY=
# Lab only: optional server default; users may enter it in the API keys tab.
# GEMINI_API_KEY=

JEV_MODEL=jev-1.13.0
LLM_MODEL=sabia-4
APP_ENV=development
EXPERIMENTAL_CONFIG_ENABLED=false
CHUNK_TOKENS=600
JEV_RELEVANCE_MARGIN_MIN=0.60
JEV_LEVEL_CONFIDENCE_MIN=0.50
JEV_DIRECTION_MARGIN_MIN=0.20
MIN_VALID_CHUNKS=16
BOOTSTRAP_SAMPLES=2000
BOOTSTRAP_SEED=42
# Optional; defaults to JEV_MODEL/LLM_MODEL when absent.
# ALLOWED_JEV_MODELS=jev-1.13.0
# ALLOWED_LLM_MODELS=sabia-4
MAX_CHARS=60000
ANALYSIS_TIMEOUT_SECONDS=120

# Reports: caminho opcional; padrão = app/api/data/reports.sqlite3.
# Use um diretório persistente e restrito à equipe responsável.
# REPORTS_DB_PATH=C:/dados/8values/reports.sqlite3
REPORTS_HOURLY_REQUESTS=60
