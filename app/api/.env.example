# Opcional: as chaves também podem ficar no .env da raiz do projeto TCC.
# Prioridade: variáveis do processo > app/api/.env > .env da raiz.
TYPESAFE_API_KEY=
MARITACA_API_KEY=
GEMINI_API_KEY=

# Parâmetros do algoritmo: edite analysis-config.json e reinicie a API.
# Caminhos relativos partem de app/api. Veja ../CONFIGURACAO.md.
# ALGORITHM_CONFIG_PATH=analysis-config.json
# Substituições opcionais têm prioridade sobre o JSON:
# JEV_MODEL=jev-1.13.0
# JEV_POLARITY_PRIMITIVE=score
# JEV_DECISION_RULE=nivel
# LLM_MODEL=sabia-4
APP_ENV=development
EXPERIMENTAL_CONFIG_ENABLED=false
# CHUNK_TOKENS=600
# CHUNK_STRATEGY=tokens
# JEV_RELEVANCE_MARGIN_MIN=0.60
# JEV_LEVEL_CONFIDENCE_MIN=0.50
# JEV_DIRECTION_MARGIN_MIN=0.20
# MIN_VALID_CHUNKS=16
# BOOTSTRAP_SAMPLES=2000
# BOOTSTRAP_SEED=42
# SEMANTIC_EVIDENCE_CHECK=false
# JEV_EVIDENCE_SEARCH=false
# EVIDENCE_EXISTENCE_MIN=0.70
# Optional; defaults to JEV_MODEL/LLM_MODEL when absent.
# ALLOWED_JEV_MODELS=jev-1.13.0
# ALLOWED_LLM_MODELS=sabia-4
# ALLOWED_GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash
MAX_CHARS=60000
MAX_TOKENS=12000
MAX_CHUNKS=20
ANALYSIS_TIMEOUT_SECONDS=120
CONCURRENT_CHUNKS=2
CONCURRENT_REQUESTS=3
HOURLY_REQUESTS=30
DAILY_PROVIDER_CALLS=1000

# Reports: caminho opcional; padrão = app/api/data/reports.sqlite3.
# Use um diretório persistente e restrito à equipe responsável.
# REPORTS_DB_PATH=C:/dados/8values/reports.sqlite3
REPORTS_HOURLY_REQUESTS=60
